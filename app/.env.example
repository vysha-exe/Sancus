# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Circle
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_ENTITY_SECRET=your-circle-entity-secret

# Public HTTPS URL Circle posts Gateway webhooks to. Must be reachable from the
# internet, so local dev needs a tunnel (e.g. ngrok) or a deployed URL. Used to
# create/sync the Gateway permissionless webhook subscription. If unset, the app
# falls back to `${NEXT_PUBLIC_APP_URL}/api/circle/webhook`; if neither is set,
# webhook registration is skipped (handler still works once events arrive).
WEBHOOK_ENDPOINT_URL=https://finch-aware-toucan.ngrok-free.app/api/circle/webhook

# Optional: dedicated endpoint for the Gateway *permissionless* webhook
# subscription. Circle requires a unique endpoint URL per subscription, so the
# Gateway subscription cannot reuse WEBHOOK_ENDPOINT_URL (used by the standard
# DCW subscription). If unset, it is derived by swapping the path of
# WEBHOOK_ENDPOINT_URL (or NEXT_PUBLIC_APP_URL) to `/api/circle/gateway-webhook`,
# which routes to the same handler. Set this only to override that default.
# GATEWAY_WEBHOOK_ENDPOINT_URL=

# Arc Testnet RPC (server-side only). Required for any Arc Testnet RPC reads
# (USDC balance lookups, etc.). Without it, requests fall back to the public
# RPC URL which is rate-limited.
ARC_TESTNET_RPC_KEY=

# Circle Kit Key (server-side). Shared by the Earn page (EarnKit), the Swap
# page (App Kit Swap) and the Add Funds dialog (Onramp Kit). When set, all
# three run in permissioned mode (integrator attribution + higher rate limits).
#
# Optional for Earn — it operates permissionlessly when this is blank. Required
# for Swap: the Stablecoin Service rejects an empty kit key, so the Swap page
# will not work without it.
#
# Get a free key from the Circle Console. Format: KIT_KEY:<keyId>:<keySecret>
KIT_KEY=

# Circle Onramp Kit. Uses KIT_KEY above — server-only, never expose to the client.
#
# The kit key must be the SANDBOX key: a key belongs to one environment, and the
# other rejects it. See the sandbox endpoints below.
#
# Settled purchases arrive as `onramp.deposit.settled` on the standard DCW
# subscription (WEBHOOK_ENDPOINT_URL above). That subscription is managed in the
# Circle Console, not by `npm run webhooks:register` — enable the notification
# type there or no onramp deposit is ever recorded.
#
# Sandbox endpoints. KEEP THESE SET. Unset, empty, or whitespace all mean the
# same thing to the onramp kit: use its production defaults, on mainnet, where
# every purchase charges a real payment method and cannot be reversed. Since
# this app only ever creates testnet wallets, a production session has nowhere
# valid to settle, so /api/onramp/session refuses to mint one — but do not rely
# on that refusal instead of setting these.
#
# Set BOTH together; they must always resolve to the same environment.
# NEXT_PUBLIC_* is inlined at build time, so restart `npm run dev` after a
# change here.
ONRAMP_API_BASE_URL=https://api-test.circle.com
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io

# Cloudsmith auth for @crcl-main/onramp-kit (private canary build). This is an
# *npm* credential, not a runtime env var — put it in your personal ~/.npmrc as
# described in .npmrc, not here. Listed only so it isn't a surprise when
# `npm install` 404s on the @crcl-main scope.

# Sancus: Singapore payouts (simulated rate + partner until StraitsX sandbox access)
SANCUS_USD_SGD_RATE=1.3400
SANCUS_FX_SPREAD_BPS=30
# Set to the partner's USDC deposit address to make the USDC leg a real Arc testnet transfer
# SANCUS_SETTLEMENT_ADDRESS=0x...

# Sancus: demo auto-login (skips sign-up/login; the demo user is created on first visit).
# Anyone who opens the app is signed in as this user, so use only for testnet demos.
# Production builds also need SANCUS_DEMO_LOGIN_ALLOW_PRODUCTION=true.
SANCUS_DEMO_LOGIN=true
SANCUS_DEMO_EMAIL=demo@sancus.app
SANCUS_DEMO_PASSWORD=sancus-demo-1

# Hackathon accounts. Only the admin account can log in for now; the employee
# account is seeded for later role-based UI work.
SANCUS_ADMIN_EMAIL=admin@gmail.com
SANCUS_ADMIN_PASSWORD=password
SANCUS_EMPLOYEE_EMAIL=employee@gmail.com
SANCUS_EMPLOYEE_PASSWORD=password
# Optional: separate HMAC secret for the signed admin cookie. If omitted, the
# server-side Supabase secret is used.
SANCUS_SESSION_SECRET=

# --- Payment partner sandboxes (optional; also used by rails-demo/) ---

# Marqeta
MARQETA_BASE_URL=https://sandbox-api.marqeta.com/v3
MARQETA_APPLICATION_TOKEN=
MARQETA_ADMIN_ACCESS_TOKEN=
MARQETA_CARD_PRODUCT_TOKEN=

# Midtrans QRIS sandbox. This creates a sandbox merchant QR; the Midtrans
# simulator emulates the payer wallet.
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
# Notification URL: https://your-public-app.example/api/sancus/webhooks/midtrans

# Omise PromptPay collection (test mode)
OMISE_BASE_URL=https://api.omise.co
OMISE_SECRET_KEY=
# Webhook: https://your-public-app.example/api/sancus/webhooks/omise

# Xendit outbound payout sandbox (Thailand PromptPay, Indonesia BI-FAST,
# Philippines InstaPay/PESONet). Development keys only; production keys are
# deliberately rejected by the app.
XENDIT_SECRET_KEY=xnd_development_replace_me
XENDIT_WEBHOOK_TOKEN=replace_with_dashboard_webhook_token
XENDIT_BASE_URL=https://api.xendit.co
# Webhook: https://your-public-app.example/api/sancus/webhooks/xendit

# PayZu Pix collection + outbound QR/key payments. Public sandbox tokens last
# 24 hours; replace PAYZU_SANDBOX_TOKEN when PayZu returns PZA100.
PAYZU_BASE_URL=https://pix.sandbox.payzu.dev/v1
PAYZU_SANDBOX_TOKEN=

# Hackathon fallback mode. When true, Marqeta and PayZu use deterministic
# SIM-* responses even if sandbox credentials are present. Provider errors are
# never silently converted into fallbacks while this is false.
SANCUS_DEMO_FALLBACKS=false

# Seed for the Brazil balance projection (minor BRL units; 500000 = R$5,000).
SANCUS_DEMO_BRL_OPENING_BALANCE_MINOR=500000
# Webhook: https://your-public-app.example/api/sancus/webhooks/payzu

# REMOVE BEFORE SUBMISSION � shows a Dev QA tab on every account to smoke-test payment rails.
# NEXT_PUBLIC_SANCUS_DEV_QA=true

