# Copy to .env and fill in. TESTNET VALUES ONLY. Never commit .env.

# --- Chain: Arc testnet (Circle's USDC-native L1) ---
CHAIN_ID=5042002
RPC_URL=https://rpc.testnet.arc.io
EXPLORER_URL=https://explorer.testnet.arc.io
# USDC ERC-20 interface on Arc (6 decimals; native balance uses 18). Copy the full
# address from https://docs.arc.io/arc/references/contract-addresses and read decimals() on-chain.
USDC_ADDRESS=
EURC_ADDRESS=

# --- Circle developer suite (self-serve: https://console.circle.com) ---
CIRCLE_API_KEY=
# 32-byte entity secret you generate and register in the Console. Circle never stores it.
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# Wallet IDs created by the setup script
TREASURY_WALLET_ID=
OPERATOR_WALLET_ID=
AGENT_WALLET_ID=
# Webhook signing / notification endpoint (v2 notifications; dedupe on notification ID)
CIRCLE_WEBHOOK_URL=

# --- Circle Gateway (unified USDC balance) ---
GATEWAY_API_URL=https://gateway-api-testnet.circle.com
# Gateway Wallet contract on Arc testnet (domain 26). Verify against Circle's docs.
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
GATEWAY_MINTER_ADDRESS=

# --- Sancus contracts (written by the deploy script) ---
DEPLOYER_PRIVATE_KEY=
TREASURY_FACTORY_ADDRESS=

# --- Database (Supabase / Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sancus
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payment partners (sandbox) ---
# Singapore payouts (USDC -> SGD via PayNow/FAST)
STRAITSX_API_URL=
STRAITSX_API_KEY=
# USD deposits / ACH payouts
BRIDGE_API_URL=https://api.sandbox.bridge.xyz/v0
BRIDGE_API_KEY=
# Cards and Asia collections live in rails-demo/.env (Marqeta, Midtrans QRIS, Omise PromptPay, PayZu Pix)

# --- Simulation tuning ---
SIM_SETTLEMENT_DELAY_SECONDS=20
