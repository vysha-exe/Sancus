# Copy to .env and fill in. TESTNET VALUES ONLY. Never commit .env.

# --- Chain (default: Base Sepolia) ---
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
# Testnet USDC address: verify against Circle's docs before deploying
USDC_ADDRESS=

# --- Alternative: Arc testnet (Circle's USDC-native L1) ---
# CHAIN_ID=5042002
# RPC_URL=
# USDC_ADDRESS=   # see docs.arc.io contract addresses; read decimals() on-chain

# --- Keys (testnet only) ---
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
SETTLEMENT_ACCOUNT_ADDRESS=

# --- Deployed contracts (written by deploy script) ---
TREASURY_FACTORY_ADDRESS=

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sancus

# --- Auth (Privy) ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Simulation tuning ---
SIM_SETTLEMENT_DELAY_SECONDS=20
