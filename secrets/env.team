# --- Circle (testnet) ---
CIRCLE_API_KEY=9188785365a4fae50518e3ade7613de2:eaf0f7c63a10dc117c0ead9ff2c0df9d
# Required for developer-controlled wallets. Register at:
# https://developers.circle.com/wallets/dev-controlled/register-entity-secret
CIRCLE_ENTITY_SECRET=

# Public HTTPS URL Circle posts webhooks to (ngrok or deployed).
WEBHOOK_ENDPOINT_URL=https://finch-aware-toucan.ngrok-free.app/api/circle/webhook
# Optional override for Gateway permissionless webhooks (must be a different URL).
# GATEWAY_WEBHOOK_ENDPOINT_URL=

# Arc Testnet RPC (server-side). Blank = public RPC (rate-limited).
ARC_TESTNET_RPC_KEY=

# Circle Kit Key — Earn / Swap / Onramp. Format: KIT_KEY:<keyId>:<keySecret>
# Must be the SANDBOX kit key.
KIT_KEY=

# Onramp sandbox endpoints — keep both set (never leave blank or it hits production).
ONRAMP_API_BASE_URL=https://api-test.circle.com
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io

# --- Sancus Singapore payouts (simulated until StraitsX) ---
SANCUS_USD_SGD_RATE=1.3400
SANCUS_FX_SPREAD_BPS=30
# SANCUS_SETTLEMENT_ADDRESS=0x...

# --- Demo auto-login ---
# Anyone who opens the app is this user — testnet demos only.
# Production also needs SANCUS_DEMO_LOGIN_ALLOW_PRODUCTION=true.
SANCUS_DEMO_LOGIN=true
SANCUS_DEMO_EMAIL=demo@sancus.app
SANCUS_DEMO_PASSWORD=sancus-demo-1

